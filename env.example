RETRIEVAL_TOP_K=5

# Database Configuration
DATABASE_USER=trantor
DATABASE_PASSWORD=trantor_pass
DATABASE_NAME=trantor_db
# DATABASE_URL=postgresql://trantor:trantor_pass@localhost:5432/trantor_db



# Embedding Model
EMBED_MODEL=BAAI/bge-small-en-v1.5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000


# LLM Provider Selection
LLM_PROVIDER=ollama  # "ollama" or "openrouter"
ENABLE_FALLBACK=true  # Use OpenRouter when Ollama fails

# LLM Configuration
LLM_MODEL=ollama:qwen2.5:7b-instruct
GPU_LAYERS=20

